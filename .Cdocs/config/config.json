{
  "site": {
    "title": "Cnkrru'notes",
    "description": "个人知识库 —— 后端 / 前端 / 框架 / 硬件 / 电气 / 数据格式等技术笔记",
    "theme": "dark",
    "url": "https://notes.cnkrru.top",
    "i18n": {
      "defaultLocale": "zh-CN",
      "dir": ".Cdocs/i18n",
      "locales": {
        "zh-CN": {
          "label": "简体中文"
        },
        "en": {
          "label": "English"
        }
      }
    },
    "editLink": {
      "base": "",
      "docsDir": "md"
    },
    "route": {
      "md": "route/docs.json"
    },
    "home": {
      "hero": {
        "title": "Cnkrru'notes",
        "subtitle": "后端 / 前端 / 框架 / 电气 / 硬件 / 数据格式等技术笔记知识库",
        "cta": {
          "text": "开始阅读",
          "file": "docs/index"
        }
      },
      "cards": false
    }
  },
  "head": {
    "logo": "",
    "showSearch": true,
    "showThemeToggle": true,
    "nav": [
      {
        "title": "{{navHome}}",
        "file": "index"
      },
      {
        "title": "{{navDocs}}",
        "file": "docs/index"
      }
    ]
  },
  "center": {
    "plugins": [
      "search",
      "dark-mode",
      "pager",
      "back-to-top",
      "toc",
      "code-highlight"
    ],
    "backToTop": {
      "threshold": 300,
      "label": "顶部"
    }
  },
  "footer": {
    "text": "© 2026 Cnkrru'notes · 由 Cdocs 生成"
  }
}
